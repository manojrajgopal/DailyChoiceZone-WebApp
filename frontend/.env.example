# All optional — the storefront runs with none of these set.

# Data source: "mock" (default) reads local JSON, "http" uses the REST API.
NEXT_PUBLIC_DATA_SOURCE=mock

# Base URL for the REST API. Only used when NEXT_PUBLIC_DATA_SOURCE=http.
# NEXT_PUBLIC_API_URL=https://api.dailychoicezone.com

# Artificial delay in milliseconds on every mock data call. Set to something
# like 400 to make loading skeletons visible while working on them.
NEXT_PUBLIC_MOCK_LATENCY=0
