# Where the API is.
#
# Optional in development — `client.ts` defaults to http://localhost:8000/api,
# which is where `uvicorn app.main:app` serves. Set it for any deployment.
#
# NEXT_PUBLIC_ is required: this is read in the browser, and it is safe there
# because it is only an address. No secret belongs in this file — the database
# password, the JWT secret and the payment keys live in backend/.env and never
# leave the server.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
