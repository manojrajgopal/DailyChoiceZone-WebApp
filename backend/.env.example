# Daily Choice Zone — backend environment
# Copied from .env.example. Never commit this file.

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=root
DATABASE_NAME=daily_choice_zone
DATABASE_ECHO=false

JWT_SECRET_KEY=change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

APP_NAME=Daily Choice Zone API
API_PREFIX=/api
ENVIRONMENT=development
DEBUG=true

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

AUTO_CREATE_DATABASE=true
AUTO_MIGRATE=true
AUTO_SEED=true

PAYMENT_PROVIDER=mock

# Payment RazorPay
RAZOR_KEY_ID=rzp_test_*********
RAZOR_KEY_SECRET=*********************
