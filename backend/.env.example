# Daily Choice Zone — backend environment
# Copied from .env.example. Never commit this file.

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=root
DATABASE_NAME=daily_choice_zone
DATABASE_ECHO=false

JWT_SECRET_KEY=change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

APP_NAME=Daily Choice Zone API
API_PREFIX=/api
ENVIRONMENT=development
DEBUG=true

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Reverse proxies whose X-Forwarded-For header is believed (comma-separated). Only these can
# set the caller's address that sign-in and code rate limits key on. Add your load balancer's address.
TRUSTED_PROXIES=127.0.0.1,::1

AUTO_CREATE_DATABASE=true
AUTO_MIGRATE=true
AUTO_SEED=true

# Which gateway takes the money.
#   mock     — no gateway, no network, no money. The default, for development.
#              Refuses to start when ENVIRONMENT=production.
#   razorpay — the real thing. Needs the three values below.
PAYMENT_PROVIDER=mock

# ---------------------------------------------------------------- Razorpay
#
# The key id is publishable: Razorpay Checkout runs in the browser and is
# served it by GET /api/payments/config. The other two are secrets that can
# take money, and neither ever reaches the frontend.
#
# Test keys start rzp_test_, live keys rzp_live_. The same code runs for both,
# but with ENVIRONMENT=production the API refuses to start on a test key.
RAZOR_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZOR_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# From Razorpay dashboard → Settings → Webhooks, when you add the webhook.
# Point it at  https://your-api-host/api/payments/webhook/razorpay  and
# subscribe to:
#   payment.captured  payment.authorized  payment.failed  order.paid
#   qr_code.credited  payment_link.paid   refund.processed  refund.failed
#
# Required in production: the API will not start without it.
#
# Leave this empty and the webhook endpoint refuses every delivery — an
# endpoint that marks orders paid on unverified input is an open door. Orders
# will still settle through the browser's verify call, but an order paid by
# somebody who then closes the tab will stay pending until you reconcile it.
RAZOR_WEBHOOK_SECRET=

# ------------------------------------------------------------ Payment window
#
# A prepaid order holds its stock for PAYMENT_WINDOW_SECONDS. Unpaid by then,
# it is cancelled and the stock goes back on sale. A payment that lands after
# that is refunded automatically — it never confirms a cancelled order.
#
# The grace period covers a payment already in flight when the clock runs out
# (a bank's OTP page, a UPI app waiting on a PIN). The sweeper checks every
# PAYMENT_SWEEP_SECONDS. A customer may have at most
# MAX_UNPAID_ORDERS_PER_CUSTOMER holds open at once, so nobody can lock up
# the stock of a product by starting checkouts and walking away.
PAYMENT_WINDOW_SECONDS=300
PAYMENT_GRACE_SECONDS=90
PAYMENT_SWEEP_SECONDS=30
MAX_UNPAID_ORDERS_PER_CUSTOMER=3

# Where customers come back to after paying by Payment Link. Must be https in
# production.
STOREFRONT_URL=http://localhost:3000

# ---------------------------------------------------------------- Amazon S3
#
# Product photo uploads. Leave empty and the product form accepts image links
# only; fill in the first three and uploading switches on — no code change.
# Nothing is stored on this server: files go to the bucket, and the database
# keeps their public address. The bucket needs a policy allowing public
# s3:GetObject on the prefix (see backend/README.md).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
# Optional: a CloudFront (or other) address to serve files from.
AWS_S3_PUBLIC_URL=
# Optional: an S3-compatible service instead of AWS.
AWS_S3_ENDPOINT_URL=
AWS_S3_PREFIX=products

# ----------------------------------------------------------------- Email
#
# The sending account (Gmail via Google OAuth, or SMTP) is set up in the admin
# portal under Settings → Email, stored encrypted in the database, and saved
# only after a test email arrives. Nothing email-related is needed here.
#
# Optional: a dedicated key for encrypting those credentials. When empty they
# are encrypted with a key derived from JWT_SECRET_KEY. Changing either makes
# saved email credentials unreadable, and the portal asks for them again.
EMAIL_ENCRYPTION_KEY=
# Optional: this API's public address. Google's OAuth redirect is
# <PUBLIC_API_URL>/auth/callback — add that to the OAuth client's authorised
# redirect URIs. Empty: worked out from the request (e.g. http://localhost:8000).
PUBLIC_API_URL=

# ------------------------------------------------- Email design, SMS, WhatsApp
#
# All optional. With none set, email works as before and SMS/WhatsApp are shown
# as "not configured" in Admin → Notifications — nothing is ever faked as sent.
# Full guide: docs/messaging-and-backups.md
#
# SMS: none | twilio. Sender: a Twilio number (+1415…) or Messaging Service SID (MG…).
NOTIFICATION_SMS_PROVIDER=none
NOTIFICATION_SMS_SENDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
#
# WhatsApp: none | meta (WhatsApp Business Cloud API) | twilio.
NOTIFICATION_WHATSAPP_PROVIDER=none
# Twilio only, e.g. whatsapp:+14155238886
NOTIFICATION_WHATSAPP_SENDER=
# Meta only. The app secret verifies webhooks; the verify token is any string you choose.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v20.0
#
# PUBLIC_API_URL (above, under Email) also enables email open tracking for
# campaigns and the Twilio delivery-status callback.

# ------------------------------------------------------------ Database backups
#
# Schedule and retention are set in Admin → Settings → Backups.
#   local — BACKUP_LOCAL_DIR (default backend/var/backups, git-ignored)
#   s3    — BACKUP_S3_BUCKET (or AWS_S3_BUCKET) under BACKUP_S3_PREFIX, private,
#           server-side encrypted, never mixed with product photos.
BACKUP_STORAGE=local
BACKUP_LOCAL_DIR=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=database-backups
# Strongly recommended: any long random string. Encrypts every backup with
# AES-256-GCM. Keep a copy OFF this server — without it backups can't be read.
BACKUP_ENCRYPTION_KEY=

# ------------------------------------------------------------ Couriers
#
# Courier accounts (Shiprocket, or Manual for couriers without an API) are set
# up in the admin portal under Settings > Couriers and stored ENCRYPTED in the
# database, with the same key as email credentials (EMAIL_ENCRYPTION_KEY, or
# JWT_SECRET_KEY when that is empty). No courier credential belongs in this file.
# See docs/shipping-and-suppliers.md.
#
# Optional tuning:
# Seconds to wait for a courier API before giving up (and retrying later).
SHIPPING_HTTP_TIMEOUT_SECONDS=15
# Only change this to route Shiprocket calls through a proxy.
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
#
# Customer segmentation: how often (seconds) the segments job refreshes the
# metrics of customers whose orders changed. Optional.
SEGMENTS_JOB_INTERVAL_SECONDS=600
#
# Search & filters (docs/search-and-filters.md): the search backend (only
# `mysql` today) and how many days raw search logs are kept. Optional.
SEARCH_BACKEND=mysql
SEARCH_LOG_RETENTION_DAYS=180
#
# The webhook address shown in Settings > Couriers is built from PUBLIC_API_URL
# (above): <PUBLIC_API_URL>/api/shipping/webhooks/shiprocket. It must be HTTPS
# and reachable from the internet for the courier to deliver tracking updates.

# --- Product discovery (docs/product-discovery.md) --------------------------
# Products remembered per signed-in customer, and for how many days.
RECENTLY_VIEWED_LIMIT=50
RECENTLY_VIEWED_RETENTION_DAYS=180
# Lines a customer can keep under "Saved for later".
SAVED_FOR_LATER_LIMIT=100
# Seconds a computed recommendation list, and a pincode's delivery terms, are
# reused. Stock is never cached; edits in the portal clear these at once.
RECOMMENDATION_CACHE_SECONDS=300
AVAILABILITY_CACHE_SECONDS=120

# ------------------------------------------------- Customer sign-in methods
#
# Social login, one-time codes and sessions. See docs/authentication.md.
# A social provider is offered only when its credentials are set here AND it is
# switched on in Admin > Settings > Authentication. Redirect URI to register
# with each provider: <PUBLIC_API_URL>/api/auth/oauth/<google|apple|microsoft>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: the Services ID, your team id, and a "Sign in with Apple" key (.p8).
# The private key may be written on one line with \n for the line breaks.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Microsoft (Entra ID): tenant common | consumers | organizations | <tenant id>
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
OAUTH_HTTP_TIMEOUT_SECONDS=10
# How long a device stays signed in (access tokens are renewed within it).
SESSION_LIFETIME_DAYS=30
#
# One-time codes by SMS: console (development only — the code is written to the
# server log; refused when ENVIRONMENT=production) | twilio (TWILIO_* above) |
# msg91 | none. Email codes use the email account from Settings > Email.
OTP_SMS_PROVIDER=console
# Twilio: overrides NOTIFICATION_SMS_SENDER for codes. MSG91: the DLT sender id.
OTP_SENDER_ID=
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=45
OTP_LENGTH=6
OTP_PER_DESTINATION_HOURLY=5
OTP_PER_DESTINATION_DAILY=10
OTP_PER_IP_HOURLY=20
OTP_PER_ACCOUNT_HOURLY=10
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
