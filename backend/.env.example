# Daily Choice Zone — backend environment
# Copied from .env.example. Never commit this file.

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=root
DATABASE_NAME=daily_choice_zone
DATABASE_ECHO=false

JWT_SECRET_KEY=change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

APP_NAME=Daily Choice Zone API
API_PREFIX=/api
ENVIRONMENT=development
DEBUG=true

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

AUTO_CREATE_DATABASE=true
AUTO_MIGRATE=true

# Which gateway takes the money.
#   mock     — no gateway, no network, no money. The default.
#   razorpay — the real thing. Needs the three values below.
PAYMENT_PROVIDER=mock

# ---------------------------------------------------------------- Razorpay
#
# The key id is publishable: Razorpay Checkout runs in the browser and is
# served it by GET /api/payments/config. The other two are secrets that can
# take money, and neither ever reaches the frontend.
#
# Test keys start rzp_test_, live keys rzp_live_. The same code runs for both.
RAZOR_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZOR_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# From Razorpay dashboard → Settings → Webhooks, when you add the webhook.
# Point it at  https://your-api-host/api/payments/webhook/razorpay  and
# subscribe to payment.captured, payment.authorized and payment.failed.
#
# Leave this empty and the webhook endpoint refuses every delivery — an
# endpoint that marks orders paid on unverified input is an open door. Orders
# will still settle through the browser's verify call, but an order paid by
# somebody who then closes the tab will stay pending until you reconcile it.
RAZOR_WEBHOOK_SECRET=
